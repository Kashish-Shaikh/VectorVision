{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Stage 1: verify environment + dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["verify"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Stage 1: verify (skip Earth Engine)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["verify", "--skip-ee"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "List stages",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["stages"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
